COMPOSE_PROFILES=
POSTGRES_DB=tillora
POSTGRES_USER=tillora
POSTGRES_PASSWORD=__GENERATE_SECRET__
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/tillora
SPRING_DATASOURCE_USERNAME=tillora
SPRING_DATASOURCE_PASSWORD=${POSTGRES_PASSWORD}
SPRING_REDIS_HOST=redis
SPRING_REDIS_PORT=6379
API_HOST_PORT=8080
MANAGEMENT_PORT=8081
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380

TILLORA_JWT_SECRET=__GENERATE_SECRET__
TILLORA_PLATFORM_ADMIN_JWT_SECRET=__GENERATE_SECRET__
TILLORA_COMPANY_PROVISIONING_TOKEN=__GENERATE_SECRET__
TILLORA_MANAGEMENT_PASSWORD=__GENERATE_SECRET__
TILLORA_ACCESS_TOKEN_TTL=15m
TILLORA_REFRESH_TOKEN_TTL=7d
TILLORA_COOKIE_SECURE=false
TILLORA_COOKIE_SAME_SITE=Lax
TILLORA_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

TILLORA_OBJECT_STORAGE_ENABLED=false
TILLORA_OBJECT_STORAGE_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=tillora-local
MINIO_ROOT_PASSWORD=__GENERATE_SECRET__
TILLORA_OBJECT_STORAGE_ACCESS_KEY=${MINIO_ROOT_USER}
TILLORA_OBJECT_STORAGE_SECRET_KEY=${MINIO_ROOT_PASSWORD}
TILLORA_OBJECT_STORAGE_BUCKET=tillora-files
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=__GENERATE_SECRET__
TILLORA_EMAIL_ENABLED=false

TILLORA_BOOTSTRAP_ENABLED=true
TILLORA_BOOTSTRAP_COMPANY_NAME='Demo Company'
TILLORA_BOOTSTRAP_COMPANY_LEGAL_NAME='Demo Company'
TILLORA_BOOTSTRAP_COMPANY_TAX_NUMBER=1111111111
TILLORA_BOOTSTRAP_CURRENCY=TRY
TILLORA_BOOTSTRAP_TIMEZONE=Europe/Istanbul
TILLORA_BOOTSTRAP_ADMIN_USERNAME=admin
TILLORA_BOOTSTRAP_ADMIN_EMAIL=admin@example.test
TILLORA_BOOTSTRAP_ADMIN_PASSWORD=__GENERATE_SECRET__
TILLORA_BOOTSTRAP_ADMIN_FIRST_NAME=Demo
TILLORA_BOOTSTRAP_ADMIN_LAST_NAME=Admin
TILLORA_PLATFORM_ADMIN_BOOTSTRAP_ENABLED=false
