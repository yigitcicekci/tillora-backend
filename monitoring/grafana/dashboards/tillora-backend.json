{
  "annotations": {
    "list": []
  },
  "editable": false,
  "panels": [
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"tillora-backend\"}[5m]))",
          "legendFormat": "requests"
        }
      ],
      "title": "HTTP Request Rate",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"tillora-backend\"}[5m])))",
          "legendFormat": "p95"
        }
      ],
      "title": "HTTP p95 Latency",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "targets": [
        {
          "expr": "sum(increase(tillora_login_attempts_total{outcome=\"failure\"}[15m]))",
          "legendFormat": "failures"
        }
      ],
      "title": "Login Failures",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 8
      },
      "id": 5,
      "targets": [
        {
          "expr": "sum(rate(tillora_database_slow_queries_total[10m]))",
          "legendFormat": "slow queries"
        }
      ],
      "title": "Slow Database Operations",
      "type": "stat"
    }
  ],
