TILLORA_IMAGE=ghcr.io/<github-owner>/tillora-backend:<commit-sha>
TILLORA_ADMIN_WEB_IMAGE=ghcr.io/<github-owner>/tillora-web:<commit-sha>
TZ=Europe/Istanbul
TILLORA_API_DOMAIN=api.example.com
TILLORA_ADMIN_DOMAIN=admin.example.com

POSTGRES_DB=tillora
POSTGRES_USER=tillora
POSTGRES_PASSWORD=<strong-random-database-password>
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/tillora
SPRING_DATASOURCE_USERNAME=tillora
SPRING_DATASOURCE_PASSWORD=<same-as-postgres-password>
TILLORA_DB_MAX_POOL_SIZE=10
TILLORA_DB_MIN_IDLE=2
TILLORA_DB_CONNECTION_TIMEOUT=5s
TILLORA_DB_VALIDATION_TIMEOUT=3s
TILLORA_DB_IDLE_TIMEOUT=10m
TILLORA_DB_MAX_LIFETIME=30m

SPRING_REDIS_HOST=redis
SPRING_REDIS_PORT=6379
REDIS_PASSWORD=<strong-random-redis-password>
SPRING_REDIS_CONNECT_TIMEOUT=2s
SPRING_REDIS_TIMEOUT=2s

TILLORA_JWT_SECRET=<base64-encoded-random-secret-at-least-32-bytes>
TILLORA_PLATFORM_ADMIN_JWT_SECRET=<separate-base64-encoded-random-secret-at-least-32-bytes>
CLOUDFLARE_API_TOKEN="<scoped-cloudflare-api-token-for-your-zone-dns-01>"
TILLORA_ACCESS_TOKEN_TTL=15m
TILLORA_REFRESH_TOKEN_TTL=7d
TILLORA_COOKIE_SECURE=true
TILLORA_COOKIE_SAME_SITE=Lax
TILLORA_CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
TILLORA_LOGIN_MAX_ATTEMPTS=10
TILLORA_LOGIN_RATE_WINDOW=1m
TILLORA_COMPANY_PROVISIONING_TOKEN=<strong-random-company-provisioning-token-at-least-32-characters>

MANAGEMENT_SERVER_ADDRESS=0.0.0.0
MANAGEMENT_SERVER_PORT=8081
TILLORA_MANAGEMENT_PASSWORD=<strong-random-management-password-at-least-16-characters>
SPRINGDOC_ENABLED=false

TILLORA_OBJECT_STORAGE_ENABLED=false
TILLORA_OBJECT_STORAGE_ENDPOINT=
TILLORA_OBJECT_STORAGE_ACCESS_KEY=
TILLORA_OBJECT_STORAGE_SECRET_KEY=
TILLORA_OBJECT_STORAGE_BUCKET=tillora-files
TILLORA_OBJECT_STORAGE_MAX_SIZE=25MB
TILLORA_OBJECT_STORAGE_CONNECT_TIMEOUT=3s
TILLORA_OBJECT_STORAGE_READ_TIMEOUT=15s
TILLORA_OBJECT_STORAGE_WRITE_TIMEOUT=15s


TILLORA_DASHBOARD_CACHE_TTL=60s
TILLORA_SLOW_QUERY_THRESHOLD=500ms
TILLORA_SHUTDOWN_TIMEOUT=30s
TILLORA_HTTP_CONNECTION_TIMEOUT=5s
TILLORA_HTTP_KEEP_ALIVE_TIMEOUT=20s
TILLORA_HTTP_MAX_CONNECTIONS=512
TILLORA_HTTP_MAX_THREADS=64
TILLORA_HTTP_MIN_SPARE_THREADS=4
TILLORA_RELEASE_VERSION=<commit-sha>
JAVA_TOOL_OPTIONS=-XX:InitialRAMPercentage=20 -XX:MaxRAMPercentage=60 -XX:+ExitOnOutOfMemoryError -Djava.io.tmpdir=/tmp -Duser.timezone=Europe/Istanbul
TILLORA_BOOTSTRAP_ENABLED=false
TILLORA_BOOTSTRAP_COMPANY_NAME=
TILLORA_BOOTSTRAP_COMPANY_LEGAL_NAME=
TILLORA_BOOTSTRAP_COMPANY_TAX_NUMBER=
TILLORA_BOOTSTRAP_CURRENCY=TRY
TILLORA_BOOTSTRAP_TIMEZONE=Europe/Istanbul
TILLORA_BOOTSTRAP_ADMIN_USERNAME=
TILLORA_BOOTSTRAP_ADMIN_EMAIL=
TILLORA_BOOTSTRAP_ADMIN_PASSWORD=
TILLORA_BOOTSTRAP_ADMIN_FIRST_NAME=
TILLORA_BOOTSTRAP_ADMIN_LAST_NAME=
TILLORA_PLATFORM_ADMIN_BOOTSTRAP_ENABLED=false
TILLORA_PLATFORM_ADMIN_BOOTSTRAP_EMAIL=
TILLORA_PLATFORM_ADMIN_BOOTSTRAP_PASSWORD=

TILLORA_BACKUP_DIR=/opt/tillora/backups
TILLORA_BACKUP_RETENTION_DAYS=14
TILLORA_BACKUP_RCLONE_REMOTE=
